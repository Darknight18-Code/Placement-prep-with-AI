generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("MONGODB_URI")
}

// 🚀 MUST HAVE THIS FOR CLERK AUTH TO WORK!
model User {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  clerkId   String   @unique
  email     String   @unique
  name      String?
  picture   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("users") 
}

model Interview {
  id                String    @id @default(auto()) @map("_id") @db.ObjectId
  userId            String
  jobRole           String
  jobDescription    String
  yearsOfExperience Int
  resumeText        String?
  interviewType     String    @default("Mixed")
  questionCount     Int       @default(5)
  questions         String[]
  duration          Int?      

  finalized         Boolean   @default(false)
  createdAt         DateTime  @default(now())
  feedback          Feedback?
}

model Feedback {
  id                  String    @id @default(auto()) @map("_id") @db.ObjectId
  totalScore          Int
  feedback            String
  communicationScore  Int?
  technicalScore      Int?
  problemSolvingScore Int?
  fitScore            Int?
  confidenceScore     Int?
  strengths           String[]
  improvements        String[]
  nextSteps           String[]  

  interviewId         String    @unique @db.ObjectId
  interview           Interview @relation(fields: [interviewId], references: [id])
}

enum Difficulty {
  easy
  medium
  hard
}

model Problem {
  id          String     @id @default(auto()) @map("_id") @db.ObjectId
  title       String
  description String
  questionNo  Int        @unique
  difficulty  Difficulty
  topic       String
  constraints String
  examples    Example[]
  hints       String[]
  testCases   TestCase[]
  metadata    Json
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  
  submissions Submission[] 

  @@map("problems") // 🚀 FIX: Connects to your existing data!
}

model Submission {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  userId      String   // Clerk User ID
  code        String
  language    String
  status      String   // "correct" (for heatmap), "wrong", or "error"
  passedCount Int      // How many test cases passed
  totalCount  Int      // Total test cases in that run
  runtime     Int?     // Execution time in ms
  
  problem     Problem  @relation(fields: [problemId], references: [id], onDelete: Cascade)
  problemId   String   @db.ObjectId
  
  createdAt   DateTime @default(now())

  @@map("Submissions") // 🚀 FIX: Connects to your existing data!
}

type Example {
  input       String
  output      String
  explanation String?
}

model TestCase {
  id             String   @id @default(auto()) @map("_id") @db.ObjectId
  input          String
  expectedOutput String
  isSample       Boolean  @default(false)
  isHidden       Boolean  @default(false)
  problem        Problem  @relation(fields: [problemId], references: [id], onDelete: Cascade)
  problemId      String   @db.ObjectId

  @@map("testcases") // 🚀 FIX: Connects to your existing data!
}